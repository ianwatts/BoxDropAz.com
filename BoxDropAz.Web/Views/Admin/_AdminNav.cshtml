@model BoxDropAz.Core.Models.Regions.Region
@{
    var current = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var regionId = Model?.Id;

    string Tab(string action) => string.Equals(current, action, StringComparison.OrdinalIgnoreCase) ? "bd-tab active" : "bd-tab";
}

<div class="bd-tabs mb-4">
    <a class="@Tab("Index")" asp-controller="Admin" asp-action="Index" asp-route-region="@regionId">
        <i class="bi bi-speedometer2 me-1"></i>Dashboard
    </a>
    <a class="@Tab("Orders")" asp-controller="Admin" asp-action="Orders" asp-route-region="@regionId">
        <i class="bi bi-box-seam me-1"></i>Orders
    </a>
    <a class="@Tab("Inventory")" asp-controller="Admin" asp-action="Inventory" asp-route-region="@regionId">
        <i class="bi bi-boxes me-1"></i>Inventory
    </a>
    <a class="@Tab("Schedule")" asp-controller="Admin" asp-action="Schedule" asp-route-region="@regionId">
        <i class="bi bi-calendar-week me-1"></i>Schedule
    </a>
    <a class="bd-tab @(string.Equals(ViewContext.RouteData.Values["controller"] as string, "Worker", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
       asp-controller="Worker" asp-action="Index" asp-route-region="@regionId">
        <i class="bi bi-clipboard-check me-1"></i>Manifest
    </a>
    <a class="@Tab("Users")" asp-controller="Admin" asp-action="Users" asp-route-region="@regionId">
        <i class="bi bi-people me-1"></i>Users
    </a>
    <a class="@Tab("Notifications")" asp-controller="Admin" asp-action="Notifications" asp-route-region="@regionId">
        <i class="bi bi-bell me-1"></i>Notifications
    </a>
    @if (User.IsInRole(Roles.SaaSAdmin))
    {
        <a class="bd-tab" asp-controller="SaaSAdmin" asp-action="Index">
            <i class="bi bi-globe2 me-1"></i>Platform
        </a>
    }
</div>

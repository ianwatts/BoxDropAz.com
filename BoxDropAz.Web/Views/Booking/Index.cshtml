@model BoxDropAz.Web.Models.Booking.PackageSelectViewModel

<div class="bd-app-header">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1>Book your moving totes</h1>
                <p class="text-muted mb-0">Step 1 of 3 &middot; Choose your bundle</p>
            </div>
            @if (Model.AllRegions.Count > 1)
            {
                <div class="btn-group" role="group" aria-label="Choose a region">
                    @foreach (var region in Model.AllRegions)
                    {
                        var isActive = Model.Region?.Id == region.Id;
                        <a class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-primary")"
                           asp-action="Index" asp-route-region="@region.Id">@region.Name</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<section class="bd-section">
    <div class="container">
        @if (Model.Region is null)
        {
            <div class="alert alert-warning">
                We're not taking bookings online just yet.
                <a asp-controller="Home" asp-action="Contact">Contact us</a> and we'll sort you out.
            </div>
        }
        else
        {
            <p class="text-muted text-center mb-4">
                Every bundle is a 7 day rental including delivery and pickup.
                Not sure? <a asp-controller="Home" asp-action="Faq">See the sizing guide</a>.
            </p>

            <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
                @foreach (var package in Model.Packages)
                {
                    <div class="col">
                        <div class="bd-price-card @(string.IsNullOrEmpty(package.Badge) ? "" : "featured")">
                            @if (!string.IsNullOrEmpty(package.Badge))
                            {
                                <span class="bd-price-badge">@package.Badge</span>
                            }

                            <h2 class="h5 fw-bold mb-1">@package.Name</h2>
                            <p class="text-muted small mb-3">@package.Subtitle</p>

                            <div class="d-flex align-items-baseline gap-2 mb-1">
                                <span class="bd-price">@Money.FormatCompact(package.BasePriceCents)</span>
                                <span class="bd-price-suffix">/ 7 days</span>
                            </div>
                            <p class="text-muted small mb-0">
                                @Money.FormatCompact(package.ExtraWeekPriceCents) for each extra week
                            </p>

                            <ul class="bd-feature-list">
                                @foreach (var item in package.IncludedItems)
                                {
                                    <li>@item</li>
                                }
                            </ul>

                            <a class="btn @(string.IsNullOrEmpty(package.Badge) ? "btn-outline-primary" : "btn-primary") w-100"
                               asp-action="Schedule"
                               asp-route-region="@Model.Region.Id"
                               asp-route-package="@package.PackageId"
                               asp-route-zip="@Model.Zip">
                                Select and continue
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@model BoxDropAz.Web.Models.Dashboard.CustomerDashboardViewModel
@{
    ViewData["Title"] = "My rentals";
}

<div class="bd-app-header">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h1>My rentals</h1>
                <p class="text-muted mb-0">
                    @if (Model.HasCardOnFile)
                    {
                        <text>@Model.CardBrand ending @Model.CardLast4 on file</text>
                    }
                    else
                    {
                        <text>No card on file</text>
                    }
                </p>
            </div>
            <div class="d-flex gap-2">
                <form asp-action="UpdatePaymentMethod" method="post" data-submit-once>
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-credit-card me-1"></i>
                        @(Model.HasCardOnFile ? "Update card" : "Add a card")
                    </button>
                </form>
                <a class="btn btn-primary" asp-controller="Booking" asp-action="Index">Book more crates</a>
            </div>
        </div>
    </div>
</div>

<section class="bd-section">
    <div class="container">
        <h2 class="h5 fw-bold mb-3">Current rentals</h2>

        @if (Model.Active.Count == 0)
        {
            <div class="bd-card mb-5">
                <div class="bd-empty">
                    <i class="bi bi-box-seam"></i>
                    Nothing active right now.
                    <div class="mt-3">
                        <a class="btn btn-primary" asp-controller="Booking" asp-action="Index">Book crates</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3 mb-5">
                @foreach (var order in Model.Active)
                {
                    <div class="col-lg-6">
                        <div class="bd-card h-100">
                            <div class="bd-card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="text-muted small">@order.OrderNumber</div>
                                        <h3 class="h6 fw-bold mb-0">@order.PackageName</h3>
                                    </div>
                                    <span class="@StatusBadge.CssFor(order.Status)">
                                        @StatusBadge.LabelFor(order.Status)
                                    </span>
                                </div>

                                <div class="bd-review-row">
                                    <span class="bd-review-label">Delivery</span>
                                    <span class="bd-review-value">
                                        @(DateOnly.TryParse(order.DeliveryDate, out var del)
                                            ? del.ToString("ddd, MMM d")
                                            : order.DeliveryDate)
                                        <span class="text-muted small d-block fw-normal">@order.DeliveryWindow</span>
                                    </span>
                                </div>
                                <div class="bd-review-row">
                                    <span class="bd-review-label">Pickup</span>
                                    <span class="bd-review-value">
                                        @(DateOnly.TryParse(order.PickupDate, out var pick)
                                            ? pick.ToString("ddd, MMM d")
                                            : order.PickupDate)
                                        <span class="text-muted small d-block fw-normal">@order.PickupWindow</span>
                                    </span>
                                </div>
                                <div class="bd-review-row">
                                    <span class="bd-review-label">Crates</span>
                                    <span class="bd-review-value">
                                        @order.CrateCount crates &middot; @order.DollyCount dollies
                                    </span>
                                </div>

                                @if (order.OutstandingDamageCents > 0)
                                {
                                    <div class="alert alert-warning small mt-3 mb-0">
                                        @Money.Format(order.OutstandingDamageCents) in equipment charges is under review.
                                    </div>
                                }

                                <a class="btn btn-outline-primary w-100 mt-3"
                                   asp-action="Detail" asp-route-id="@order.OrderId">
                                    Manage this rental
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.Past.Count > 0)
        {
            <h2 class="h5 fw-bold mb-3">Past rentals</h2>
            <div class="bd-table">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Bundle</th>
                                <th>Dates</th>
                                <th class="text-end">Total</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Past)
                            {
                                <tr>
                                    <td class="text-muted small">@order.OrderNumber</td>
                                    <td>@order.PackageName</td>
                                    <td class="small">@order.DeliveryDate &rarr; @order.PickupDate</td>
                                    <td class="text-end">@Money.Format(order.AmountPaidCents)</td>
                                    <td>
                                        <span class="@StatusBadge.CssFor(order.Status)">
                                            @StatusBadge.LabelFor(order.Status)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Detail" asp-route-id="@order.OrderId">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <p class="text-muted small mt-4 mb-0">
            Charges after delivery follow the
            <a asp-controller="Legal" asp-action="RentalTerms">rental agreement</a> you accepted at checkout.
        </p>
    </div>
</section>

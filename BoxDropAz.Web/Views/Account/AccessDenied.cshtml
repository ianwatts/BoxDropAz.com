@{
    ViewData["Title"] = "Access denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card auth-card shadow-sm text-center">
                <div class="card-body p-4 p-md-5">
                    <div class="display-5 mb-3">&#128274;</div>
                    <h1 class="h3 fw-bold mb-3">Access denied</h1>
                    <p class="text-muted mb-4">
                        Your account doesn't have permission to view that page. If you think this is a
                        mistake, contact your administrator.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Back to home</a>
                </div>
            </div>
        </div>
    </div>
</div>

@using Microsoft.AspNetCore.Authentication
@{
    var externalLogins = ViewData["ExternalLogins"] as IList<AuthenticationScheme> ?? new List<AuthenticationScheme>();
    var returnUrl = ViewData["ExternalReturnUrl"] as string;
    var accountType = ViewData["ExternalAccountType"] as string;
}

@if (externalLogins.Count > 0)
{
    <div class="auth-divider my-4"><span>or continue with</span></div>

    <div class="d-grid gap-2 mb-2">
        @foreach (var provider in externalLogins)
        {
            <form asp-action="ExternalLogin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="@provider.Name" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <input type="hidden" name="accountType" value="@accountType" />
                <button type="submit" class="btn btn-outline-secondary btn-lg w-100 auth-social-btn">
                    @if (string.Equals(provider.Name, "Google", StringComparison.OrdinalIgnoreCase))
                    {
                        <svg class="auth-social-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.9z"/>
                            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.1 8 3l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.3 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
                            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-1.1 3.1-3.5 5.5-6.5 6.6l.1.1 6.2 5.2C36.8 40.7 44 36 44 24c0-1.3-.1-2.7-.4-3.9z"/>
                        </svg>
                        <span>Continue with Google</span>
                    }
                    else if (string.Equals(provider.Name, "Facebook", StringComparison.OrdinalIgnoreCase))
                    {
                        <svg class="auth-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="#1877F2" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.09 24 18.1 24 12.07z"/>
                        </svg>
                        <span>Continue with Facebook</span>
                    }
                    else
                    {
                        <span>Continue with @provider.DisplayName</span>
                    }
                </button>
            </form>
        }
    </div>
}

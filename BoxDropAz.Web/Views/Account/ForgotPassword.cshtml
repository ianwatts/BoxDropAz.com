@model BoxDropAz.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card auth-card shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 fw-bold mb-1">Reset your password</h1>
                    <p class="text-muted mb-4">Enter your email and we'll send you a reset link.</p>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">Send reset link</button>
                    </form>

                    <p class="text-center text-muted mt-4 mb-0">
                        <a asp-action="Login">Back to sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

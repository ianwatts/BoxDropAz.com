@model BoxDropAz.Web.Models.Public.ThankYouViewModel
@using System.Globalization
@using System.Text.Json
@inject IConfiguration Configuration
@{
    var order = Model.Order;
    var googleAdsId = Configuration["Seo:GoogleAdsId"];
    var googleAdsLabel = Configuration["Seo:GoogleAdsPurchaseLabel"];
    var adsSendTo = !string.IsNullOrWhiteSpace(googleAdsId) && !string.IsNullOrWhiteSpace(googleAdsLabel)
        ? $"{googleAdsId}/{googleAdsLabel}"
        : "";
}

<section class="bd-section">
    <div class="container" style="max-width: 720px;">
        @if (order is null)
        {
            <div class="text-center mb-4">
                <div class="bd-success-mark"><i class="bi bi-check-lg"></i></div>
                <h1 class="mt-3">Thank you</h1>
                <p class="text-muted">
                    Your moving tote rental is confirmed. We emailed the details to you.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
            </div>
        }
        else
        {
            var deliveryDate = DateOnly.TryParse(order.DeliveryDate, out var d) ? d.ToString("dddd, MMMM d") : order.DeliveryDate;
            var pickupDate = DateOnly.TryParse(order.PickupDate, out var p) ? p.ToString("dddd, MMMM d") : order.PickupDate;

            <div class="text-center mb-4">
                <div class="bd-success-mark"><i class="bi bi-check-lg"></i></div>
                <h1 class="mt-3">Thank you</h1>
                <p class="text-muted">
                    You're booked. Order <strong>@order.OrderNumber</strong>. We emailed a confirmation to @order.CustomerEmail.
                </p>
            </div>

            <div class="bd-card mb-4">
                <div class="bd-card-body">
                    <h2 class="h5 fw-bold mb-3">What happens next</h2>
                    <ol class="bd-numbered-list">
                        <li>
                            <strong>We deliver @deliveryDate</strong> during your @order.DeliveryWindow window.
                            You'll get a text that morning with a tighter arrival estimate.
                        </li>
                        <li>
                            <strong>Pack, move, unpack.</strong> The totes, lids, and dollies are yours through @pickupDate.
                            Need longer? Extend from your dashboard in a click.
                        </li>
                        <li>
                            <strong>We collect @pickupDate</strong> during your @order.PickupWindow window.
                            Leave them stacked by the door &mdash; no need to be home.
                        </li>
                    </ol>
                </div>
            </div>

            <div class="bd-card mb-4">
                <div class="bd-card-body">
                    <h2 class="h5 fw-bold mb-3">Your order</h2>

                    <div class="bd-review-row">
                        <span class="bd-review-label">Bundle</span>
                        <span class="bd-review-value">
                            @order.PackageName<br />
                            <span class="text-muted small">@order.CrateCount totes with lids &middot; @order.DollyCount custom-fit dollies</span>
                        </span>
                    </div>
                    <div class="bd-review-row">
                        <span class="bd-review-label">Delivery address</span>
                        <span class="bd-review-value">
                            @order.DeliveryAddressLine1@(string.IsNullOrWhiteSpace(order.DeliveryAddressLine2) ? "" : ", " + order.DeliveryAddressLine2)<br />
                            <span class="text-muted small">@order.DeliveryCity, AZ @order.DeliveryZip</span>
                        </span>
                    </div>
                    @if (order.GiftCreditAppliedCents > 0)
                    {
                        <div class="bd-review-row">
                            <span class="bd-review-label">Gift credit</span>
                            <span class="bd-review-value bd-credit">
                                -@Money.Format(order.GiftCreditAppliedCents)
                                @if (!string.IsNullOrWhiteSpace(order.GiftingRealtorName))
                                {
                                    <br />
                                    <span class="text-muted small fw-normal">Courtesy of @order.GiftingRealtorName</span>
                                }
                            </span>
                        </div>
                    }
                    <div class="bd-review-row">
                        <span class="bd-review-label">Paid today</span>
                        <span class="bd-review-value">
                            @Money.Format(order.AmountPaidCents)
                            @if (order.TaxCents > 0)
                            {
                                <br />
                                <span class="text-muted small fw-normal">includes @Money.Format(order.TaxCents) Arizona tax</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(order.CardLast4))
                            {
                                <br />
                                <span class="text-muted small fw-normal">@order.CardBrand ending @order.CardLast4</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            @if (Model.AccountCreated)
            {
                <div class="alert alert-info">
                    <strong>We set up an account for you.</strong> Check your email for a link to choose a password.
                    From there you can track this rental, extend it, or update your card.
                </div>
            }

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Detail" asp-route-id="@order.OrderId">
                        View this rental
                    </a>
                }
                else
                {
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in to your dashboard</a>
                }
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to home</a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        try { sessionStorage.removeItem('bd_complete_wait'); } catch (e) { }
        @if (order is not null)
        {
            var purchaseValue = (order.AmountPaidCents / 100m).ToString("0.00", CultureInfo.InvariantCulture);
            var purchaseTax = (order.TaxCents / 100m).ToString("0.00", CultureInfo.InvariantCulture);
            var orderIdJson = JsonSerializer.Serialize(order.OrderId);
            var packageIdJson = JsonSerializer.Serialize(order.PackageId);
            var packageNameJson = JsonSerializer.Serialize(order.PackageName);
            var adsSendToJson = JsonSerializer.Serialize(adsSendTo);
            <text>
        if (typeof gtag === 'function') {
            var purchasePayload = {
                transaction_id: @Html.Raw(orderIdJson),
                value: @purchaseValue,
                tax: @purchaseTax,
                currency: 'USD',
                items: [{
                    item_id: @Html.Raw(packageIdJson),
                    item_name: @Html.Raw(packageNameJson),
                    quantity: 1
                }]
            };
            gtag('event', 'purchase', purchasePayload);
            var adsSendTo = @Html.Raw(adsSendToJson);
            var conversion = {
                transaction_id: purchasePayload.transaction_id,
                value: purchasePayload.value,
                currency: purchasePayload.currency
            };
            if (adsSendTo) {
                conversion.send_to = adsSendTo;
            }
            gtag('event', 'conversion', conversion);
        }
            </text>
        }
    </script>
}

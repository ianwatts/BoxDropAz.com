@model BoxDropAz.Web.Models.Gift.GiftClaimViewModel
@{
    var gift = Model.Gift;
    var fromLine = string.IsNullOrWhiteSpace(gift.RealtorCompany)
        ? gift.RealtorName
        : $"{gift.RealtorName}, {gift.RealtorCompany}";
}

<section class="bd-hero">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <span class="bd-eyebrow"><i class="bi bi-gift-fill"></i> A closing gift for you</span>
                <h1 class="mt-3 mb-3">
                    @gift.RealtorName sent you
                    <span style="color:var(--bd-teal);">@Money.FormatCompact(gift.GiftAmountCents)</span>
                    of reusable moving totes
                </h1>
                <p class="lead mx-auto">
                    Congratulations on @gift.PropertyAddressLine1@(string.IsNullOrWhiteSpace(gift.PropertyCity) ? "" : ", " + gift.PropertyCity).
                    27-gallon totes with lids delivered to your door &mdash; no cardboard, no tape,
                    no last minute run to the store.
                </p>

                @if (!string.IsNullOrWhiteSpace(gift.PersonalMessage))
                {
                    <blockquote class="bd-gift-note">
                        &ldquo;@gift.PersonalMessage&rdquo;
                        <footer>&mdash; @fromLine</footer>
                    </blockquote>
                }

                <a class="btn btn-primary btn-lg mt-3"
                   asp-controller="Booking" asp-action="Schedule" asp-route-gift="@gift.ClaimToken">
                    Claim my totes <i class="bi bi-arrow-right ms-1"></i>
                </a>
                <p class="text-muted small mt-3 mb-0">
                    Takes about two minutes. Your gift is applied automatically at checkout.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="bd-section">
    <div class="container">
        <div class="bd-section-head text-center mb-4">
            <h2>What your gift covers</h2>
            <p class="text-muted">
                @if (Model.FullyCoveredPackage is not null)
                {
                    <text>
                        @Money.FormatCompact(gift.GiftAmountCents) covers the
                        <strong>@Model.FullyCoveredPackage.Name</strong> bundle outright.
                        Want more totes or longer than a week? You just pay the difference.
                    </text>
                }
                else
                {
                    <text>
                        @Money.FormatCompact(gift.GiftAmountCents) comes straight off your total.
                        Pick whichever bundle fits your home and pay only what's left.
                    </text>
                }
            </p>
        </div>

        @if (Model.Packages.Count > 0)
        {
            <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
                @foreach (var package in Model.Packages)
                {
                    var covered = package.BasePriceCents <= gift.GiftAmountCents;
                    var difference = Math.Max(0, package.BasePriceCents - gift.GiftAmountCents);

                    <div class="col">
                        <div class="bd-price-card @(covered ? "featured" : "")">
                            @if (covered)
                            {
                                <span class="bd-price-badge">Fully covered</span>
                            }

                            <h3 class="h5 fw-bold mb-1">@package.Name</h3>
                            <p class="text-muted small mb-3">@package.Subtitle</p>

                            <div class="d-flex align-items-baseline gap-2 mb-1">
                                <span class="bd-price">
                                    @(covered ? "$0" : Money.FormatCompact(difference))
                                </span>
                                <span class="bd-price-suffix">you pay</span>
                            </div>
                            <p class="text-muted small mb-0">
                                <s>@Money.FormatCompact(package.BasePriceCents)</s>
                                after your @Money.FormatCompact(gift.GiftAmountCents) gift
                            </p>

                            <ul class="bd-feature-list">
                                @foreach (var item in package.IncludedItems)
                                {
                                    <li>@item</li>
                                }
                            </ul>

                            <a class="btn @(covered ? "btn-primary" : "btn-outline-primary") w-100"
                               asp-controller="Booking" asp-action="Schedule"
                               asp-route-gift="@gift.ClaimToken"
                               asp-route-package="@package.PackageId">
                                Choose @package.Name
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="bd-section bd-section-alt">
    <div class="container">
        <div class="bd-section-head text-center mb-4">
            <h2>How it works</h2>
        </div>
        <div class="row g-4 row-cols-1 row-cols-md-3">
            <div class="col text-center">
                <div class="bd-step-mark">1</div>
                <h3 class="h6 fw-bold mt-3">Pick your dates</h3>
                <p class="text-muted small">
                    Choose a delivery day and a two hour window. We need two days' notice.
                </p>
            </div>
            <div class="col text-center">
                <div class="bd-step-mark">2</div>
                <h3 class="h6 fw-bold mt-3">We deliver, you pack</h3>
                <p class="text-muted small">
                    Totes, lids, and custom-fit dollies arrive stacked and ready. Pack at your own pace over the week.
                </p>
            </div>
            <div class="col text-center">
                <div class="bd-step-mark">3</div>
                <h3 class="h6 fw-bold mt-3">We collect</h3>
                <p class="text-muted small">
                    Leave them stacked by the door on pickup day. You don't even need to be home.
                </p>
            </div>
        </div>

        <p class="text-center text-muted small mt-4 mb-0">
            Questions? <a asp-controller="Home" asp-action="Contact">Get in touch</a> or read the
            <a asp-controller="Legal" asp-action="RentalTerms">rental terms</a>.
        </p>
    </div>
</section>

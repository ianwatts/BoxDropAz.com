@model BoxDropAz.Web.Models.Gift.GiftUnavailableViewModel
@{
    ViewData["Title"] = "This gift link isn't active";
}

<section class="bd-section">
    <div class="container" style="max-width: 620px;">
        <div class="bd-card">
            <div class="bd-card-body text-center py-5">
                <i class="bi bi-gift" style="font-size:2.75rem;color:var(--bd-line);"></i>
                <h1 class="h4 fw-bold mt-3">This gift link isn't active</h1>
                <p class="text-muted">@Model.Reason</p>

                <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-outline-secondary" asp-controller="Booking" asp-action="Index">
                        Book crates directly
                    </a>
                </div>

                <p class="text-muted small mt-4 mb-0">
                    @if (!string.IsNullOrWhiteSpace(Model.AgentName))
                    {
                        <text>@Model.AgentName can send a fresh link, or </text>
                    }
                    <a asp-controller="Home" asp-action="Contact">contact us</a> and we'll help.
                </p>
            </div>
        </div>
    </div>
</section>
